<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
  "-//Checkstyle//DTD SuppressionFilter Configuration 1.0//EN"
  "https://checkstyle.org/dtds/suppressions_1_0.dtd">
<suppressions>
  <!-- Test files must use FeatureToTest_StateUnderTest_ExpectedBehavior; skip regular camelCase rule -->
  <suppress id="MethodNameRegular" files=".*[\\/]src[\\/]test[\\/].*"/>
  <!-- Production files use camelCase; skip the test naming rule -->
  <suppress id="MethodNameTest" files=".*[\\/]src[\\/]main[\\/].*"/>
</suppressions>
